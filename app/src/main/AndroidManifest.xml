<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions arrive with the features that need them (see TODO.md); every one is
         pinned in app/expected-permissions.txt, which is verified against the merged
         release manifest on every `check`. INTERNET must never appear here: the app is
         fully offline by spec. -->

    <!-- Both live in the CALENDAR group, so one runtime dialog grants them together.
         READ_CALENDAR is everything the app reads (TODO.md §4.1); WRITE_CALENDAR is
         only for the RSVP "Yes, going" written when alarms are set (§4.6). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Package visibility (API 30+) for long-press "open in calendar": lets resolveActivity
         see the calendar app that views content://com.android.calendar/events/… and /time/…
         (TODO.md §4.1). Not a permission; nothing is added to expected-permissions.txt. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
    </queries>

    <application
        android:name=".MeetingMinderApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="${appIcon}"
        android:label="@string/app_name"
        android:roundIcon="${appIconRound}"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeetingMinder">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
