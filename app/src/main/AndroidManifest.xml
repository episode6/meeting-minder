<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions arrive with the features that need them (see TODO.md); every one is
         pinned in app/expected-permissions.txt, which is verified against the merged
         release manifest on every `check`. INTERNET must never appear here: the app is
         fully offline by spec. -->

    <!-- Both live in the CALENDAR group, so one runtime dialog grants them together.
         READ_CALENDAR is everything the app reads (TODO.md §4.1); WRITE_CALENDAR is
         only for the RSVP "Yes, going" written when alarms are set (§4.6). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Exact, alarm-clock-class alarms (TODO.md §4.4). Not being on Play lets us declare
         USE_EXACT_ALARM (33+, auto-granted, not revocable) so no special-access prompt is
         needed; SCHEDULE_EXACT_ALARM covers 12/12L, where it is pre-granted but revocable
         (the "Alarms & reminders" onboarding row). Both gate on canScheduleExactAlarms(). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- The ringing and missed-alarm notifications (and PR-11's schedule-changed
         notification); a runtime permission on 33+ (onboarding row). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms never survive a shutdown: BootReceiver re-arms every stored one. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The ringing experience (TODO.md §4.4). The ringing notification's full-screen
         intent wakes the screen into AlarmActivity (granted by default for a sideloaded
         install on 34+, revocable: the "Full-screen alarms" onboarding row). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- AlarmRingingService: a mediaPlayback foreground service, because it plays the alarm. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The random vibration waveform that rings alongside the sound. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- AlarmWakeLock: the alarm broadcast's own wake lock ends when AlarmReceiver returns,
         before the ringing service exists, so the CPU is kept awake from the receiver
         until the ringing stops. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Package visibility (API 30+) for long-press "open in calendar": lets resolveActivity
         see the calendar app that views content://com.android.calendar/events/… and /time/…
         (TODO.md §4.1). Not a permission; nothing is added to expected-permissions.txt. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="com.android.calendar" />
        </intent>
    </queries>

    <application
        android:name=".MeetingMinderApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="${appIcon}"
        android:label="@string/app_name"
        android:roundIcon="${appIconRound}"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeetingMinder">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Every alarm PendingIntent targets this (see AndroidAlarmScheduler); nothing
             outside the app may fire it. -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- Rings a fired alarm: sound, vibration and the ringing notification
             (TODO.md §4.4). mediaPlayback: no timeout, no runtime prerequisite. -->
        <service
            android:name=".alarm.AlarmRingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The ringing screen, launched only by the ringing notification's full-screen
             intent: over the lock screen, waking the screen, in its own task that never
             shows in recents. -->
        <activity
            android:name=".alarm.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MeetingMinder.Alarm"
            android:turnScreenOn="true" />

        <!-- Re-arms stored alarms after the OS may have dropped them (TODO.md §4.4). All of
             these are protected system broadcasts, which reach a non-exported receiver. -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
