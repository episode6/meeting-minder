    <string name="day_fab_clear_alarms">Clear alarms</string>
    <!-- FAB label once alarms are set -->
    <string name="day_fab_share">Share schedule</string>
    <!-- app bar subtitle once alarms are set, e.g. "3 alarms set · not shared yet" -->
    <plurals name="day_subtitle_alarms_set">
        <item quantity="one">%d alarm set</item>
        <item quantity="other">%d alarms set</item>
    </plurals>
    <string name="day_subtitle_not_shared_yet">%1$s · not shared yet</string>
    <!-- app bar subtitle once the day has been shared, e.g. "shared 8:12 AM" -->
    <string name="day_subtitle_shared_at">shared %1$s</string>
    <!-- snackbars after "Set alarms" -->
    <plurals name="day_alarms_set_today">
        <item quantity="one">%d alarm set for today</item>
        <item quantity="other">%d alarms set for today</item>
    </plurals>
    <!-- %2$s is the day, e.g. "Tuesday, Sep 15" -->
    <plurals name="day_alarms_set_on_day">
        <item quantity="one">%1$d alarm set for %2$s</item>
        <item quantity="other">%1$d alarms set for %2$s</item>
    </plurals>
    <plurals name="day_alarms_skipped">
        <item quantity="one">%d alarm skipped, already started</item>
        <item quantity="other">%d alarms skipped, already started</item>
    </plurals>
    <string name="day_alarms_set_some_skipped">%1$d set, %2$d skipped (already started)</string>
    <!-- after "Clear alarms": every selection had been removed, the tap only cancelled -->
    <plurals name="day_alarms_cleared">
        <item quantity="one">%d alarm cleared</item>
        <item quantity="other">%d alarms cleared</item>
    </plurals>
    <string name="alarms_exact_permission_missing">Allow alarms &amp; reminders in Permissions to set alarms</string>
    <string name="day_all_day">all-day</string>
