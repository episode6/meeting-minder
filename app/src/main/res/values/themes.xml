<resources>
    <!-- Window theme used before compose takes over (and by the system for the
         starting window). The compose UI's colours live in ui/theme/ — keep the
         window background in sync with the light scheme's surface so launches don't
         flash a different colour. A platform parent on purpose: the UI is all
         Compose, so pulling in com.google.android.material (and the View-system
         stack behind it) just for this parent would be dead weight. -->
    <style name="Theme.MeetingMinder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
